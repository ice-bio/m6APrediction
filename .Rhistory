tabItems(
tabItem(tabName = "pred_multi",
h4("Step 1. Upload an input feature CSV file"),
fileInput("upload_csv", "Upload CSV"),
actionButton("load_example", "Example data"),
h4("Step 2. Select a decision threshold for the positive class probability"),
sliderInput("threshold", "Threshold", min = 0, max = 1, value = 0.5),
h4("Step 3. Click Predict to run inference"),
actionButton("run_predict", "Predict"),
downloadButton("download_res", "Download"),
br(),
DTOutput("pred_table")
)
)
)
)
server <- function(input, output) {
rv <- reactiveValues(raw_data = NULL, pred_data = NULL)
observeEvent(input$upload_csv, {
rv$raw_data <- read.csv(input$upload_csv$datapath)
rv$pred_data <- NULL
})
observeEvent(input$load_example, {
rv$raw_data <- example_data
rv$pred_data <- NULL
})
observeEvent(c(input$run_predict, input$threshold), {
req(rv$raw_data)
rv$pred_data <- prediction_multiple(rf_fit, rv$raw_data, positive_threshold = input$threshold)
})
output$pred_table <- renderDT({
show_table <- if (!is.null(rv$pred_data)) rv$pred_data else rv$raw_data
req(show_table)
datatable(show_table, options = list(scrollX = TRUE, pageLength = 15))
})
output$download_res <- downloadHandler(
filename = "predicted.csv",
content = function(file) {
write.csv(rv$pred_data, file, row.names = FALSE)
}
)
}
shinyApp(ui, server)
# Prompt for AI helpers:
# Please do NOT generate overly comprehensive or decorative code.
# Keep the app minimal, readable, and only implement the exact requested features.
# Avoid adding extra UI elements, error checking, styling, or animations.
# The goal is clarity and simplicity for beginners.
# ---- app.R (single-file style) ----
library(shiny)
library(shinydashboard)
library(DT)
suppressWarnings(library(randomForest))
rf_fit <- readRDS("rf_fit.rds")
example_data <- read.csv("m6A_input_example.csv")
dna_encoding <- function(dna_strings){
nn <- nchar( dna_strings[1] )
seq_m <- matrix( unlist( strsplit(dna_strings, "") ), ncol = nn, byrow = TRUE)
colnames(seq_m) <- paste0("nt_pos", 1:nn)
seq_df <- as.data.frame(seq_m)
seq_df[] <- lapply(seq_df, factor, levels = c("A", "T", "C", "G"))
return(seq_df)
}
prediction_multiple <- function(ml_fit, feature_df, positive_threshold = 0.5){
stopifnot(all(c("gc_content", "RNA_type", "RNA_region", "exon_length", "distance_to_junction", "evolutionary_conservation", "DNA_5mer") %in% colnames(feature_df)))
dna_split <- dna_encoding(feature_df$DNA_5mer)
feature_df <- cbind(feature_df, dna_split)
feature_df$RNA_type <- factor(feature_df$RNA_type, levels = c("mRNA", "lincRNA", "lncRNA", "pseudogene"))
feature_df$RNA_region <- factor(feature_df$RNA_region, levels = c("CDS", "intron", "3'UTR", "5'UTR"))
feature_set <- c("gc_content", "RNA_type", "RNA_region", "exon_length",
"distance_to_junction", "evolutionary_conservation",
"nt_pos1", "nt_pos2", "nt_pos3", "nt_pos4", "nt_pos5")
prob_out <- predict(ml_fit, newdata = feature_df[, feature_set], type = "prob")
feature_df$predicted_m6A_prob <- prob_out[, "Positive"]
feature_df$predicted_m6A_status <- ifelse(feature_df$predicted_m6A_prob > positive_threshold,
"Positive", "Negative")
return(feature_df)
}
prediction_single <- function(ml_fit, gc_content, RNA_type, RNA_region, exon_length, distance_to_junction, evolutionary_conservation, DNA_5mer, positive_threshold = 0.5){
feature_df <- data.frame(
gc_content = gc_content,
RNA_type = RNA_type,
RNA_region = RNA_region,
exon_length = exon_length,
distance_to_junction = distance_to_junction,
evolutionary_conservation = evolutionary_conservation,
DNA_5mer = DNA_5mer,
stringsAsFactors = FALSE
)
res_df <- prediction_multiple(ml_fit, feature_df, positive_threshold = positive_threshold)
returned_vector <- c(
predicted_m6A_prob = res_df$predicted_m6A_prob,
predicted_m6A_status = res_df$predicted_m6A_status
)
return(returned_vector)
}
ui <- dashboardPage(
dashboardHeader(title = "m6A Prediction Server"),
dashboardSidebar(
sidebarMenu(
menuItem("m6A Prediction Multiple", tabName = "pred_multi")
)
),
dashboardBody(
tabItems(
tabItem(tabName = "pred_multi",
h4("Step 1. Upload an input feature CSV file"),
fileInput("upload_csv", "Upload CSV"),
actionButton("load_example", "Example data"),
h4("Step 2. Select a decision threshold for the positive class probability"),
sliderInput("threshold", "Threshold", min = 0, max = 1, value = 0.5),
h4("Step 3. Click Predict to run inference"),
actionButton("run_predict", "Predict"),
downloadButton("download_res", "Download"),
br(),
DTOutput("pred_table")
)
)
)
)
server <- function(input, output) {
rv <- reactiveValues(raw_data = NULL, pred_data = NULL)
observeEvent(input$upload_csv, {
rv$raw_data <- read.csv(input$upload_csv$datapath)
rv$pred_data <- NULL
})
observeEvent(input$load_example, {
rv$raw_data <- example_data
rv$pred_data <- NULL
})
observeEvent(c(input$run_predict, input$threshold), {
req(rv$raw_data)
rv$pred_data <- prediction_multiple(rf_fit, rv$raw_data, positive_threshold = input$threshold)
})
output$pred_table <- renderDT({
show_table <- if (!is.null(rv$pred_data)) rv$pred_data else rv$raw_data
req(show_table)
datatable(show_table, options = list(scrollX = TRUE, pageLength = 15))
})
output$download_res <- downloadHandler(
filename = "predicted.csv",
content = function(file) {
write.csv(rv$pred_data, file, row.names = FALSE)
}
)
}
shinyApp(ui, server)
