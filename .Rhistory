ui <- dashboardPage(
dashboardHeader(title = "m6A Prediction Server"),
dashboardSidebar(
sidebarMenu(
menuItem("m6A Prediction Multiple", tabName = "pred_multi"),
menuItem("m6A Prediction Single", tabName = "pred_single")
)
),
dashboardBody(
tabItems(
# Tab 1: Batch prediction (from Step 5)
tabItem(tabName = "pred_multi",
h4("Step 1. Upload an input feature CSV file"),
fileInput("upload_csv", "Upload CSV"),
actionButton("load_example", "Example data"),
h4("Step 2. Select a decision threshold for the positive class probability"),
sliderInput("threshold", "Threshold", min = 0, max = 1, value = 0.5),
h4("Step 3. Click Predict to run inference"),
actionButton("run_predict", "Predict"),
downloadButton("download_res", "Download"),
br(),
DTOutput("pred_table")
),
# Tab 2: Single manual input prediction (Step 6 NEW)
tabItem(tabName = "pred_single",
h4("Set the feature values below."),
p("The model will automatically predict whether this site is m6A (‘Positive’ or ‘Negative’)."),
p("The probability score reflects model confidence."),
fluidRow(
column(width = 6,
selectInput("RNA_type_s", "RNA_type",
choices = c("mRNA", "lincRNA", "lncRNA", "pseudogene"),
selected = "mRNA"),
selectInput("RNA_region_s", "RNA_region",
choices = c("CDS", "intron", "3'UTR", "5'UTR"),
selected = "CDS"),
sliderInput("gc_content_s", "gc_content", min = 0, max = 1, value = 0.5),
sliderInput("exon_length_s", "exon_length", min = 0, max = 15, value = 10),
sliderInput("distance_to_junction_s", "distance_to_junction", min = 0, max = 15, value = 8),
sliderInput("evolutionary_conservation_s", "evolutionary_conservation", min = 0, max = 1, value = 0.5),
textInput("DNA_5mer_s", "DNA_5mer", value = "GGACA")
),
column(width = 6,
infoBoxOutput("prob_box"),
infoBoxOutput("status_box")
)
)
)
)
)
)
server <- function(input, output) {
rv <- reactiveValues(raw_data = NULL, pred_data = NULL)
# Batch prediction logic (Step5)
observeEvent(input$upload_csv, {
rv$raw_data <- read.csv(input$upload_csv$datapath)
rv$pred_data <- NULL
})
observeEvent(input$load_example, {
rv$raw_data <- example_data
rv$pred_data <- NULL
})
observeEvent(c(input$run_predict, input$threshold), {
req(rv$raw_data)
rv$pred_data <- prediction_multiple(rf_fit, rv$raw_data, positive_threshold = input$threshold)
})
output$pred_table <- renderDT({
show_table <- if (!is.null(rv$pred_data)) rv$pred_data else rv$raw_data
req(show_table)
datatable(show_table, options = list(scrollX = TRUE, pageLength = 15))
})
output$download_res <- downloadHandler(
filename = "predicted.csv",
content = function(file) {
write.csv(rv$pred_data, file, row.names = FALSE)
}
)
# Single prediction reactive (auto update, no button)
single_pred_result <- reactive({
prediction_single(
ml_fit = rf_fit,
gc_content = input$gc_content_s,
RNA_type = input$RNA_type_s,
RNA_region = input$RNA_region_s,
exon_length = input$exon_length_s,
distance_to_junction = input$distance_to_junction_s,
evolutionary_conservation = input$evolutionary_conservation_s,
DNA_5mer = input$DNA_5mer_s,
positive_threshold = 0.5
)
})
# Render info boxes for single prediction
output$prob_box <- renderInfoBox({
infoBox("Predicted m6A Probability", single_pred_result()["predicted_m6A_prob"], fill = TRUE)
})
output$status_box <- renderInfoBox({
infoBox("Predicted m6A Status", single_pred_result()["predicted_m6A_status"], fill = TRUE)
})
}
shinyApp(ui, server)
