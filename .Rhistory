server <- function(input, output) {
rv <- reactiveValues(raw_data = NULL, pred_data = NULL)
# ===== Database section logic =====
output$db_table <- renderDT({
datatable(m6a_data, options = list(scrollX = TRUE, pageLength = 15))
})
output$viz_plot <- renderPlot({
ggplot(m6a_data, aes(x = RNA_type, fill = m6A_status)) +
geom_bar() +
theme_bw()
})
output$download_db <- downloadHandler(
filename = "m6A_imbalanced.csv",
content = function(file) {
write.csv(m6a_data, file, row.names = FALSE)
}
)
# ===== Batch prediction logic =====
observeEvent(input$upload_csv, {
rv$raw_data <- read.csv(input$upload_csv$datapath)
rv$pred_data <- NULL
})
observeEvent(input$load_example, {
rv$raw_data <- example_data
rv$pred_data <- NULL
})
observeEvent(c(input$run_predict, input$threshold), {
req(rv$raw_data)
rv$pred_data <- prediction_multiple(rf_fit, rv$raw_data, positive_threshold = input$threshold)
})
output$pred_table <- renderDT({
show_table <- if (!is.null(rv$pred_data)) rv$pred_data else rv$raw_data
req(show_table)
datatable(show_table, options = list(scrollX = TRUE, pageLength = 15))
})
output$download_res <- downloadHandler(
filename = "predicted.csv",
content = function(file) {
write.csv(rv$pred_data, file, row.names = FALSE)
}
)
# ===== Single prediction logic =====
single_pred_result <- reactive({
prediction_single(
ml_fit = rf_fit,
gc_content = input$gc_content_s,
RNA_type = input$RNA_type_s,
RNA_region = input$RNA_region_s,
exon_length = input$exon_length_s,
distance_to_junction = input$distance_to_junction_s,
evolutionary_conservation = input$evolutionary_conservation_s,
DNA_5mer = input$DNA_5mer_s,
positive_threshold = 0.5
)
})
output$prob_box <- renderInfoBox({
infoBox("Predicted m6A Probability", single_pred_result()["predicted_m6A_prob"], fill = TRUE)
})
output$status_box <- renderInfoBox({
infoBox("Predicted m6A Status", single_pred_result()["predicted_m6A_status"], fill = TRUE)
})
}
shinyApp(ui, server)
# Start shiny app
shinyApp(ui, server)
